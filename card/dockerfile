# Build stage
FROM node:20-alpine AS builder
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy workspace configuration
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml* ./
COPY package.json ./

# Copy all packages
COPY shared ./shared
COPY card ./card

# Install dependencies (allow lockfile generation inside container)
RUN pnpm install --no-frozen-lockfile

# Build shared package
WORKDIR /app/shared
RUN pnpm build

# Build card package
WORKDIR /app/card
RUN pnpm build

# Production stage
FROM node:20-alpine AS runner
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Create user for security first
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy workspace configuration
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml* ./
COPY package.json ./

# Copy shared package
COPY shared ./shared
COPY card ./card

# Copy prebuilt artifacts from builder
COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/card/.next ./card/.next

# Change ownership to nextjs user
RUN chown -R nextjs:nodejs /app

# Switch to nextjs user for dependency installation
USER nextjs

# Install only production dependencies
RUN pnpm install --no-frozen-lockfile --prod

# Set working directory to card
WORKDIR /app/card

EXPOSE 3000
ENV NODE_ENV=production
CMD ["pnpm", "start"]
